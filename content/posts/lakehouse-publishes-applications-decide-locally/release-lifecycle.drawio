<mxfile host="Electron" type="device">
  <diagram id="release-lifecycle" name="release-lifecycle">
    <mxGraphModel dx="1200" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="480" math="0" shadow="0" background="#fbfaf7">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;The release lifecycle&lt;/b&gt;" style="text;html=1;align=center;fontSize=22;fontColor=#172018;" vertex="1" parent="1">
          <mxGeometry x="50" y="18" width="1000" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="&lt;i&gt;nothing ever returns to staged — corrections arrive as successor releases&lt;/i&gt;" style="text;html=1;align=center;fontSize=14;fontColor=#5d665d;" vertex="1" parent="1">
          <mxGeometry x="50" y="50" width="1000" height="24" as="geometry" />
        </mxCell>
        <mxCell id="staged" value="&lt;b&gt;staged&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5d665d&quot;&gt;&lt;i&gt;facts writable&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbfaf7;strokeColor=#5d665d;fontColor=#172018;fontSize=16;dashed=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="90" y="130" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="active" value="&lt;b&gt;active&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5d665d&quot;&gt;&lt;i&gt;the one authoritative release&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f4e8;strokeColor=#0f766e;fontColor=#172018;fontSize=16;arcSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="460" y="130" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="superseded" value="&lt;b&gt;superseded&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5d665d&quot;&gt;&lt;i&gt;retained for rollback&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbfaf7;strokeColor=#0f766e;fontColor=#172018;fontSize=16;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="130" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="rejected" value="&lt;b&gt;rejected&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;&lt;i&gt;reason recorded&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbfaf7;strokeColor=#b45309;fontColor=#b45309;fontSize=16;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="90" y="310" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="validated + promoted &lt;br&gt;&lt;i&gt;one transaction&lt;/i&gt;" style="edgeStyle=none;html=1;strokeColor=#0f766e;fontColor=#172018;fontSize=13;endArrow=block;endFill=1;labelBackgroundColor=#fbfaf7;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="staged" target="active">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="successor activates" style="edgeStyle=none;html=1;strokeColor=#0f766e;fontColor=#172018;fontSize=13;endArrow=block;endFill=1;labelBackgroundColor=#fbfaf7;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="active" target="superseded">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="rollback — validated, lineage-checked" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0f766e;fontColor=#172018;fontSize=13;endArrow=block;endFill=1;labelBackgroundColor=#fbfaf7;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="superseded" target="active">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="935" y="250" />
              <mxPoint x="560" y="250" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e4" value="validation fails" style="edgeStyle=none;html=1;strokeColor=#b45309;fontColor=#b45309;fontSize=13;endArrow=block;endFill=1;labelBackgroundColor=#fbfaf7;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="staged" target="rejected">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="seal" value="&lt;i&gt;activation or rejection seals the manifest and facts — a correction is a new staged successor, never an edit&lt;/i&gt;" style="text;html=1;align=center;fontSize=13;fontColor=#5d665d;" vertex="1" parent="1">
          <mxGeometry x="150" y="420" width="800" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
